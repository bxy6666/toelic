generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Question {
  id              String           @id @default(cuid())
  userId          String?
  type            String
  subtype         String
  difficulty      String
  prompt          String
  optionsJson     String
  answer          String
  explanationZh   String
  tagsJson        String
  listeningScript String?
  grammarPoint    String?
  imageUrl        String?
  imagePrompt     String?
  source          String
  createdAt       DateTime         @default(now())
  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceRecords PracticeRecord[]
  mistake         Mistake?

  @@index([userId])
  @@index([type])
  @@index([difficulty])
  @@index([createdAt])
}

model PracticeRecord {
  id               String   @id @default(cuid())
  userId           String?
  questionId       String
  practiceType     String
  userAnswer       String
  isCorrect        Boolean
  timeSpentSeconds Int      @default(0)
  practicedAt      DateTime @default(now())
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  question         Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([questionId])
  @@index([practiceType])
  @@index([practicedAt])
  @@index([isCorrect])
}

model Mistake {
  id          String    @id @default(cuid())
  userId      String?
  questionId  String    @unique
  wrongCount  Int       @default(1)
  lastWrongAt DateTime  @default(now())
  status      String    @default("new")
  note        String?
  masteredAt  DateTime?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question    Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([lastWrongAt])
}

model UserSetting {
  id                   String   @id @default(cuid())
  userId               String?  @unique
  defaultDifficulty    String   @default("medium")
  defaultQuestionCount Int      @default(5)
  speechRate           Float    @default(1.0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id              String            @id @default(cuid())
  username        String            @unique
  passwordHash    String
  createdAt       DateTime          @default(now())
  sessions        Session[]
  questions       Question[]
  practiceRecords PracticeRecord[]
  mistakes        Mistake[]
  setting         UserSetting?
  generationUsage GenerationUsage[]
  papers          Paper[]
  attempts        Attempt[]
  uploadedFiles   UploadedFile[]
  importJobs      ImportJob[]
  parseJobs       ParseJob[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model GenerationUsage {
  id        String   @id @default(cuid())
  userId    String
  dateKey   String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey])
  @@index([dateKey])
}

model Paper {
  id          String         @id @default(cuid())
  userId      String
  title       String
  description String?
  sourceKey   String?
  status      String         @default("active")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions    PaperVersion[]
  attempts    Attempt[]
  files       UploadedFile[]
  importJobs  ImportJob[]
  parseJobs   ParseJob[]

  @@unique([userId, sourceKey])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model PaperVersion {
  id                     String         @id @default(cuid())
  paperId                String
  versionLabel           String
  status                 String         @default("draft")
  defaultDurationSeconds Int            @default(7200)
  publishedAt            DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  paper                  Paper          @relation(fields: [paperId], references: [id], onDelete: Cascade)
  sections               PaperSection[]
  items                  QuestionItem[]
  attempts               Attempt[]
  importJobs             ImportJob[]
  parseJobs              ParseJob[]

  @@unique([paperId, versionLabel])
  @@index([paperId])
  @@index([status])
}

model PaperSection {
  id             String         @id @default(cuid())
  paperVersionId String
  sectionCode    String?
  title          String
  instructions   String?
  orderIndex     Int
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  paperVersion   PaperVersion   @relation(fields: [paperVersionId], references: [id], onDelete: Cascade)
  items          QuestionItem[]

  @@unique([paperVersionId, orderIndex])
  @@index([paperVersionId])
}

model QuestionItem {
  id              String            @id @default(cuid())
  paperVersionId  String
  sectionId       String?
  questionNo      String
  itemType        String
  stem            String
  answerKeyJson   String
  explanationJson String?
  difficulty      String?
  orderIndex      Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  paperVersion    PaperVersion      @relation(fields: [paperVersionId], references: [id], onDelete: Cascade)
  section         PaperSection?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  options         QuestionOption[]
  responses       AttemptResponse[]

  @@unique([paperVersionId, questionNo])
  @@index([paperVersionId])
  @@index([sectionId])
  @@index([itemType])
}

model QuestionOption {
  id         String       @id @default(cuid())
  itemId     String
  optionKey  String
  optionText String
  orderIndex Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  item       QuestionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, optionKey])
  @@index([itemId])
}

model Attempt {
  id              String            @id @default(cuid())
  userId          String
  paperId         String
  paperVersionId  String
  mode            String            @default("exam")
  status          String            @default("in_progress")
  startedAt       DateTime          @default(now())
  durationSeconds Int
  expiresAt       DateTime
  submittedAt     DateTime?
  lastAutosavedAt DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper           Paper             @relation(fields: [paperId], references: [id], onDelete: Cascade)
  paperVersion    PaperVersion      @relation(fields: [paperVersionId], references: [id], onDelete: Cascade)
  responses       AttemptResponse[]
  gradingResult   GradingResult?

  @@index([userId])
  @@index([paperVersionId])
  @@index([status])
  @@index([expiresAt])
}

model AttemptResponse {
  id               String       @id @default(cuid())
  attemptId        String
  itemId           String
  answerJson       String
  timeSpentSeconds Int          @default(0)
  isCorrect        Boolean?
  score            Float?
  gradedAt         DateTime?
  autosavedAt      DateTime     @default(now())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  attempt          Attempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  item             QuestionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([attemptId, itemId])
  @@index([attemptId])
  @@index([itemId])
}

model GradingResult {
  id            String   @id @default(cuid())
  attemptId     String   @unique
  totalItems    Int
  answeredItems Int
  correctItems  Int
  wrongItems    Int
  score         Float
  accuracy      Float
  gradedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  attempt       Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model UploadedFile {
  id         String      @id @default(cuid())
  userId     String
  paperId    String?
  source     String
  originalName String    @default("")
  extension  String      @default("")
  filePath   String
  mime       String
  sizeBytes  Int
  sha256     String
  status     String      @default("uploaded")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper      Paper?      @relation(fields: [paperId], references: [id], onDelete: SetNull)
  importJobs ImportJob[]
  parseJobs  ParseJob[]

  @@index([userId])
  @@index([paperId])
  @@index([sha256])
}

model ImportJob {
  id             String        @id @default(cuid())
  userId         String
  uploadedFileId String?
  paperId        String?
  paperVersionId String?
  mode           String        @default("draft")
  optionsJson    String?
  resultJson     String?
  status         String        @default("queued")
  progress       Int           @default(0)
  errorJson      String?
  completedAt    DateTime?
  appliedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  uploadedFile   UploadedFile? @relation(fields: [uploadedFileId], references: [id], onDelete: SetNull)
  paper          Paper?        @relation(fields: [paperId], references: [id], onDelete: SetNull)
  paperVersion   PaperVersion? @relation(fields: [paperVersionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model ParseJob {
  id             String        @id @default(cuid())
  userId         String
  uploadedFileId String?
  paperId        String?
  paperVersionId String?
  parserName     String?
  sourceTextPath String?
  resultJson     String?
  confidence     Float?
  status         String        @default("queued")
  progress       Int           @default(0)
  errorJson      String?
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  uploadedFile   UploadedFile? @relation(fields: [uploadedFileId], references: [id], onDelete: SetNull)
  paper          Paper?        @relation(fields: [paperId], references: [id], onDelete: SetNull)
  paperVersion   PaperVersion? @relation(fields: [paperVersionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}
